options:
  parameters:
    author: Thème 4 - modulations numériques (simulation pure)
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ASK à 4 niveaux, 4 symboles, impulsions rectangulaires, porteuse fc, bruit blanc gaussien, oscillateur local du récepteur décalé en phase et en fréquence, filtre adapté, détection d'enveloppe.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ask4_tx_rx_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'ASK à 4 niveaux : émetteur, canal et récepteur (simulation)'
    window_size: (1200,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
