- name: constellation
  id: variable_constellation
  parameters:
    comment: 'Note that GNUradio secretly re-scales your constellation

      to have an average magnitude of 1. This is really annoying,

      but is meant to work with the AGCs that rescale the signal in this way'
    const_points: '[complex(0.0, 0.0), complex(0.3333333333333333, 0.0), complex(0.6666666666666666, 0.0), complex(1.0, 0.0)]'
    dims: '1'
    normalization: 'digital.constellation.AMPLITUDE_NORMALIZATION'
    npwr: '1.0'
    precision: '8'
    rot_sym: '1'
    soft_dec_lut: 'None'
    sym_map: '[0, 1, 2, 3]'
    type: 'calcdist'
  states:
